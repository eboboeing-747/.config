# add next line to ~/.bashrc
# source <path/to/this/file>

alias pbcopy='xclip -selection clipboard' # copy to clipboard
alias pbpaste='xclip -selection clipboard -o' # paste from clipboard

alias ls='lsd'
alias tree='lsd --tree -I node_modules -I bin -I obj'
alias grep='grep --color=auto'
alias sspnd='systemctl suspend'

alias pgctl='pg_ctl'

alias tnew='tmux new -s $(basename $(pwd))'

export dev=/mnt/shared/dev/
export SUDO_EDITOR=/usr/bin/nvim

export STARSHIP_CONFIG=~/.config/starship/starship.toml
eval "$(starship init bash)"

export FZF_DEFAULT_OPTS='--tmux 80%'
eval "$(fzf --bash --tmux 80%)"

bind 'set completion-ignore-case on'

buds() {
    if [ "$1" = "con" ]; then
        bluetoothctl devices Paired | awk '/Buds/{print $2}' | xargs -I{} bluetoothctl connect {}
        return 0
    elif [ "$1" = "dis" ]; then
        bluetoothctl devices Connected | awk '/Buds/{print $2}' | xargs -I{} bluetoothctl disconnect {}
        return 0
    fi

    echo -e "arguments not understood;\nusage: buds (con|dis)"
    return 1;
}

mon() {
    if [ "$#" -eq 0 ]; then
        hyprctl dispatch 'hl.dsp.dpms({action="toggle",monitor="eDP-1"})'
        return 0
    fi

    if [ "$1" = "on" ]; then
        hyprctl dispatch 'hl.dsp.dpms({action="on",monitor="eDP-1"})'
        return 0
    elif [ "$1" = "off" ]; then
        hyprctl dispatch 'hl.dsp.dpms({action="off",monitor="eDP-1"})'
        return 0
    fi

    echo -e "arguments not understood;\nusage: mon [on|off]"
    return 1
}

inetmh() {
    if (( "$#" > 1 )); then
        echo -e "arguments not understood;\nusage: inet [up|down]"
        return 1
    fi

    local current_ssid=$(nmcli con show --active | awk '/wifi/{ print $1 }')

    toggle() {
        nmcli con down $current_ssid
        nmcli con up $MH_SSID
    }

    if [ "$1" = "up" ]; then
         if [ "$current_ssid" = "$MH_SSID" ]; then
             echo "already connected to $MH_SSID"
         elif [ "$current_ssid" = "" ]; then
             nmcli con up $MH_SSID
         else
             toggle
         fi
         return 0
     elif [ "$1" = "down" ]; then
         if [ "$current_ssid" = "" ]; then
             echo "already no connections"
         fi
         if [ "$current_ssid" = "$MH_SSID" ]; then
             nmcli con down $MH_SSID
         fi
         return 0
    fi

    if [ "$current_ssid" = "$MH_SSID" ]; then
        nmcli con down $MH_SSID
    elif [ "$current_ssid" = "" ]; then
        nmcli con up $MH_SSID
        return 0
    elif [ "$current_ssid" != "$MH_SSID" ]; then
        toggle
        return 0
    fi

    unset -f toggle
}
